<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Phase 0: exclude hard-to-restore encrypted DB; device-transfer allowed for migration -->
        <exclude domain="database" path="resala_secure_db" />
        <exclude domain="database" path="resala_secure_db-wal" />
        <exclude domain="database" path="resala_secure_db-shm" />
        <exclude domain="sharedpref" path="resala_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="resala_secure_db" />
        <include domain="sharedpref" path="resala_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
